<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The Telescope Net Node Agent — macOS LaunchAgent

    Installed to ~/Library/LaunchAgents/ by the postinstall script, for the
    console user only, NOT a system LaunchDaemon. A root LaunchDaemon has
    no GUI session, so it can never reach the login keychain: every restart
    silently failed to read back the stored API key and the agent
    re-registered as a brand-new node, orphaning it from the member's
    account. A per-user LaunchAgent runs in that session and has normal
    keychain access, so credentials actually survive a restart.

    __HOME__ and __USER__ are substituted by postinstall.sh with the real
    console user's home directory and username at install time (a static
    plist can't reference $HOME).

    To control manually (as the signed-in user, no sudo):
        launchctl bootout  gui/$(id -u) ~/Library/LaunchAgents/com.telescopenet.nodeagent.plist
        launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.telescopenet.nodeagent.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.telescopenet.nodeagent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/TelescopeNetNode.app/Contents/MacOS/TelescopeNetNode</string>
        <string>--no-browser</string>
        <string>--data-dir</string>
        <string>__HOME__/Library/Application Support/TelescopeNet/NodeAgent</string>
    </array>

    <!-- Start immediately at load and restart on exit -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Throttle rapid restart loops -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>__HOME__/Library/Application Support/TelescopeNet/NodeAgent</string>

    <!-- Log files -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/TelescopeNet/node_agent.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/TelescopeNet/node_agent_error.log</string>

    <!-- Environment -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!--
        Power management: prevent idle sleep while the service is running.
        The node agent also calls caffeinate internally via sleep_prevention.py,
        but this assertion provides a belt-and-suspenders guarantee even if the
        Python process can't find caffeinate.
    -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
